               <id root="4af433a5-2bbe-e632-e063-6394a90a92c3"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Other information</content>
                     <br/>
• store between 15-30°C (59-86°F).
  <br/>
• Do not use if printed safety seal is torn, broken or missing.
 </paragraph>
               </text>
               <effectiveTime value="20260216"/>
            </section>
         </component>
