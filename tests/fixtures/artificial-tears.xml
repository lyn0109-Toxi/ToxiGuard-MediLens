               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>instill 1 or 2 drops in the affected eye(s) as needed</item>
                     <item>children under 6 years of age: ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20190703"/>
            </section>
         </component>
         <component>
